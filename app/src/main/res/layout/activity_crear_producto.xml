<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtTituloPantalla"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_crear_producto"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/edtTituloProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/titulo_producto"
            android:inputType="text"
            android:singleLine="true" />

        <EditText
            android:id="@+id/edtPrecioProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/precio_producto"
            android:inputType="numberDecimal"
            android:singleLine="true"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/edtDescripcionProducto"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="@string/descripcion_producto"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:paddingTop="12dp"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/edtImagenProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/url_imagen_producto"
            android:inputType="textUri"
            android:singleLine="true"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/edtCategoriaProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/categoria_producto"
            android:inputType="text"
            android:singleLine="true"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/txtErrorCrearProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#D32F2F"
            android:visibility="gone"
            android:layout_marginTop="16dp" />

        <ProgressBar
            android:id="@+id/progresoCrearProducto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/btnCrearProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/crear_producto"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>